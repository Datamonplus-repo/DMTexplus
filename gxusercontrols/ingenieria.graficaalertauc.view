<style>
  #plc_chart_granularidad {
    background-color: #7a0c0c;
    color: #ffffff;
    border: 1px solid #5a0808;
    border-radius: 4px;
    padding: 6px 10px;
    font-weight: bold;
    font-size: 13px;
    cursor: pointer;
    outline: none;
  }
  #plc_chart_granularidad option {
    background-color: #ffffff;
    color: #333333;
  }
  #plc_chart_granularidad:hover {
    background-color: #8f0f0f;
  }
  #plc_chart_granularidad_label {
    font-weight: bold;
    color: #627077;
    margin-right: 6px;
  }
  #plc_chart_btn_mostrar_todo, #plc_chart_btn_ocultar_todo {
    background-color: #7a0c0c;
    color: #ffffff;
    border: 1px solid #5a0808;
    border-radius: 4px;
    padding: 6px 10px;
    font-weight: bold;
    font-size: 12px;
    cursor: pointer;
  }
  #plc_chart_btn_mostrar_todo:hover, #plc_chart_btn_ocultar_todo:hover {
    background-color: #8f0f0f;
  }
  #plc_chart_buscador {
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  #plc_chart_buscador:focus {
    outline: none;
    border-color: #7a0c0c;
    box-shadow: 0 0 0 2px rgba(122, 12, 12, 0.25);
  } 
</style>

<div style="margin-bottom:8px;">
  <label id="plc_chart_granularidad_label" for="plc_chart_granularidad">Agrupar por: </label>
  <select id="plc_chart_granularidad">
    <option value="segundo">Segundos</option>
    <option value="minuto" selected>Minutos</option>
    <option value="hora">Horas</option>
    <option value="dia">Días</option>
  </select>
  
  <button id="plc_chart_btn_mostrar_todo" type="button">Mostrar todo</button>
  <button id="plc_chart_btn_ocultar_todo" type="button">Ocultar todo</button>

  <input id="plc_chart_buscador" type="text" placeholder="Buscar parametro..." style="padding:5px 8px; border-radius:4px; border:1px solid #ccc; min-width:180px;" />
  
</div>
<div id="plc_chart_slot" style="width:100%; height:400px;" ></div>