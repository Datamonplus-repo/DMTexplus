<style>
    .release-info { display:grid; align-content: space-between;place-items:center; background:#ffffff; color:#212529; font:500 16px/1.4 "Inter", ui-sans-serif, system-ui; padding:20px }

    .release-info .card-release { width:min(860px,96vw); background:#ffffff; position:relative }

    .release-info .title-release { display:flex; align-items:center; gap:12px; margin:0 0 8px }
    .release-info .title-release svg { flex:0 0 28px }
    .release-info .version { font-size:clamp(22px,3vw,28px); font-weight:700; letter-spacing:.2px }

    .release-info .meta { display:flex; flex-wrap:wrap; gap:10px 14px; margin-top:10px }
    .release-info .kpi { display:inline-flex; align-items:center; gap:8px; padding:8px 12px; border:1px dashed #dee2e6; border-radius:12px; color:#495057; background:#f8f9fa }
    .release-info .kpi strong { color:#212529 }

    .release-info .badge-release { position:absolute; top:12px; right:12px; font-size:12px; padding:6px 10px; border-radius:999px; border:1px solid #198754; background:#198754; color:#ffffff }

    .release-info .notes { margin-top:16px; background:#f8f9fa; border:1px solid #dee2e6; border-radius:12px; padding:14px }
    .release-info .notes h2 { margin:0 0 8px; font-size:16px; color:#212529 }
    .release-info .notes p { margin:0; color:#212529 }

    .release-info .compare { margin-top:18px; display:grid; grid-template-columns:1fr; gap:10px }
    .release-info .row { display:flex; gap:12px; flex-wrap:wrap }
    .release-info .pill { padding:6px 10px; border:1px solid #b6d4fe; border-radius:999px; font-size:14px; color:#084298; background:#e7f1ff }

    .release-info .btns { margin-top:14px; display:flex; gap:10px; flex-wrap:wrap }
    .release-info .btn-update { appearance:none; border:1px solid #0d6efd; background:#0d6efd; color:#ffffff; padding:10px 14px; border-radius:12px; font-weight:600; cursor:pointer; box-shadow:0 4px 12px rgba(13,110,253,.25) }
    .release-info .btn-update:hover { background:#0b5ed7; border-color:#0a58ca }
    .release-info .btn-update:focus { outline:0; box-shadow:0 0 0 .25rem rgba(13,110,253,.25) }
    .release-info .btn-update[disabled] { opacity:.6; cursor:not-allowed }

    .release-info .progress-wrap { margin-top:10px; background:#e9ecef; border:1px solid #dee2e6; border-radius:10px; height:14px; overflow:hidden; display:none }
    .release-info .progress-bar { height:100%; width:0%; background:#0d6efd; transition:width .15s linear }
    .release-info .progress-text { margin-top:8px; font-size:14px; color:#495057; display:none }

    .release-info .toast { position:fixed; inset:auto 20px 20px auto; background:#ffffff; color:#212529; border:1px solid #dee2e6; border-radius:12px; padding:12px 14px; box-shadow:0 10px 24px rgba(33,37,41,.10); display:none }
    .release-info time:hover { color:#212529 }
  </style>
</head>

<body>
  <div class="release-info">
    <section class="card-release" aria-labelledby="title">
      <span id="flag" class="badge-release" hidden>New release</span>

      <h1 id="title" class="title-release">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
          <path fill="currentColor" d="M12 2a3 3 0 0 1 3 3v.08A6.002 6.002 0 0 1 20 11v5a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4v-5a6.002 6.002 0 0 1 5-5.92V5a3 3 0 0 1 3-3Zm2 11a1 1 0 1 0-2 0v3a1 1 0 1 0 2 0v-3Zm-4 0a1 1 0 1 0-2 0v3a1 1 0 1 0 2 0v-3Z"/>
        </svg>
        <span class="version">Release Center</span>
      </h1>

      <div class="meta" role="group" aria-label="Release information">
        <span class="kpi" title="Current version (from URL param)">Current: <strong id="currentVersion">—</strong></span>
        <span class="kpi" title="Latest version from server">Latest: <strong id="latestVersion">—</strong></span>
        <span class="kpi" title="Release date">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="M7 2a1 1 0 0 1 1 1v1h8V3a1 1 0 1 1 2 0v1h2a2 2 0 0 1 2 2v3H2V6a2 2 0 0 1 2-2h2V3a1 1 0 0 1 1-1ZM2 10h20v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-8Zm5 3a1 1 0 0 0 0 2h3a1 1 0 1 0 0-2H7Z"/>
          </svg>
          <span>released on <strong><time id="released" datetime=""></time></strong></span>
        </span>
        <span class="kpi" title="Days since release">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="M12 2a10 10 0 1 1 0 20a10 10 0 0 1 0-20Zm1 5a1 1 0 1 0-2 0v5c0 .27.11.52.29.71l3 3a1 1 0 1 0 1.42-1.42L13 11.59V7Z"/>
          </svg>
          <span><strong id="days">—</strong> day(s) since release</span>
        </span>
        <span class="kpi" title="Mandatory update" id="mandatoryPill" hidden>
          <span class="pill">Mandatory</span>
        </span>
      </div>

      <div class="notes" aria-live="polite">
        <h2>Release notes</h2>
        <p id="notes">—</p>
      </div>

      <div class="compare">
        <div class="row">
          <span class="pill">KB: <span id="kbName">texplusnet</span></span>
          <span class="pill">SHA-256: <code id="sha">—</code></span>
          <span class="pill">Size: <span id="size">—</span></span>
        </div>
      </div>

      <div class="btns">
        <button id="btnUpdate" class="btn-update" hidden>Download update</button>
        <a id="directLink" class="btn-update" href="#" download hidden>Direct link</a>
      </div>

      <div class="progress-wrap" id="progressWrap" aria-hidden="true" aria-label="Download progress">
        <div class="progress-bar" id="progressBar"></div>
      </div>
      <div class="progress-text" id="progressText">0%</div>
    </section>

    <div class="toast" id="toast">Parabéns pela atualização! </div>
  </div>